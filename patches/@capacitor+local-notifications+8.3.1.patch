+package com.capacitorjs.plugins.localnotifications
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import androidx.core.app.NotificationManagerCompat
+import com.getcapacitor.CapConfig
+import com.getcapacitor.JSArray
+import com.getcapacitor.JSObject
+import com.getcapacitor.Logger
+import java.text.SimpleDateFormat
+import java.util.TimeZone
+import org.json.JSONArray
+import org.json.JSONException
+
+/**
+ * MedTracker (MT-145): a notification button (Taken, Snooze) runs here instead of opening the app.
+ * The phone acts on the tap at once, in case the app isn't running: the dose's reminder and its
+ * repeats go, and a snooze rings again after the snooze length (`extra.snoozeMinutes`) with its
+ * repeats after it. The tap is kept until the app has saved it ([kept], [forget]) to tell the server
+ * and re-plan.
+ */
+class NotificationActionReceiver : BroadcastReceiver() {
+
+    override fun onReceive(context: Context, intent: Intent) {
+        val id = intent.getIntExtra(LocalNotificationManager.NOTIFICATION_INTENT_KEY, Int.MIN_VALUE)
+        val actionId = intent.getStringExtra(LocalNotificationManager.ACTION_INTENT_KEY)
+        val source = intent.getStringExtra(LocalNotificationManager.NOTIFICATION_OBJ_INTENT_KEY)
+        if (id == Int.MIN_VALUE || actionId == null || source == null) return
+        val tapped = try {
+            JSObject(source)
+        } catch (e: JSONException) {
+            return
+        }
+        val now = System.currentTimeMillis()
+        keep(context, JSObject().put("actionId", actionId).put("notification", tapped).put("actedAt", now))
+
+        val storage = NotificationStorage(context)
+        val manager = LocalNotificationManager(storage, null, context, CapConfig.loadDefault(context))
+        val shade = NotificationManagerCompat.from(context)
+        val group = tapped.getString("group")
+        val sameDose = storage.getSavedNotifications().filter { it.id != id && it.id != null && group != null && it.group == group }
+        // Repeats still to ring, soonest first: after a snooze they ring again, one snooze length apart.
+        val repeats = sameDose.filter { !it.isTriggered() }.sortedBy { it.schedule?.at?.time ?: 0 }
+        shade.cancel(id)
+        if (LocalNotificationManager.isSafeToForget(storage.getSavedNotification(id.toString()))) {
+            storage.deleteNotification(id.toString())
+        }
+        for (n in sameDose) {
+            val nid = n.id ?: continue
+            shade.cancel(nid)
+            manager.cancelTimerForNotification(nid)
+            storage.deleteNotification(nid.toString())
+        }
+        if (actionId == "snooze") {
+            try {
+                snooze(tapped, repeats, now, storage, manager)
+            } catch (e: Exception) {
+                // The tap is kept: the app re-plans this dose when it next runs.
+                Logger.error(Logger.tags("LN"), "Could not snooze from the notification", e)
+            }
+        }
+        // Last, so a running app re-plans after the phone's changes, not before them.
+        LocalNotificationsPlugin.fireReminderActionsWaiting()
+    }
+
+    private fun snooze(
+        tapped: JSObject,
+        repeats: List<LocalNotification>,
+        now: Long,
+        storage: NotificationStorage,
+        manager: LocalNotificationManager
+    ) {
+        val minutes = tapped.getJSObject("extra")?.getInteger("snoozeMinutes") ?: 10
+        val step = minutes * 60_000L
+        val format = SimpleDateFormat(LocalNotificationSchedule.JS_DATE_FORMAT)
+        format.timeZone = TimeZone.getTimeZone("UTC")
+        val again = (listOf(tapped) + repeats.mapNotNull { it.source?.let(::JSObject) }).mapIndexed { i, json ->
+            val schedule = json.getJSObject("schedule") ?: JSObject()
+            schedule.put("at", format.format(now + step * (i + 1)))
+            json.put("schedule", schedule)
+            LocalNotification.buildNotificationFromJSObject(json)
+        }
+        storage.appendNotifications(again)
+        manager.schedule(null, again)
+    }
+
+    companion object {
+        private const val STORE = "MedTrackerReminderActions"
+        private const val KEY = "taps"
+
+        // The app drops older taps unsent too, so a phone whose app never takes them stays small.
+        private const val KEEP_MS = 2 * 86_400_000L
+
+        @Synchronized
+        private fun keep(context: Context, action: JSObject) {
+            save(context, read(context, action.getLong("actedAt") - KEEP_MS).put(action))
+        }
+
+        /** The taps the app hasn't saved yet, oldest first. */
+        @Synchronized
+        fun kept(context: Context): JSArray = read(context, System.currentTimeMillis() - KEEP_MS)
+
+        /** Forgets the taps the app has saved: those up to [upTo] (`actedAt`). */
+        @Synchronized
+        fun forget(context: Context, upTo: Long) {
+            save(context, read(context, upTo + 1))
+        }
+
+        /** Kept taps from [from] (`actedAt`) on. */
+        private fun read(context: Context, from: Long): JSArray {
+            val all = try {
+                JSONArray(context.getSharedPreferences(STORE, Context.MODE_PRIVATE).getString(KEY, "[]"))
+            } catch (e: JSONException) {
+                JSONArray()
+            }
+            val out = JSArray()
+            for (i in 0 until all.length()) {
+                val tap = all.optJSONObject(i) ?: continue
+                if (tap.optLong("actedAt") >= from) out.put(tap)
+            }
+            return out
+        }
+
+        private fun save(context: Context, taps: JSONArray) {
+            context.getSharedPreferences(STORE, Context.MODE_PRIVATE).edit().putString(KEY, taps.toString()).commit()
+        }
+    }
+}
