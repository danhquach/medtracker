+    private fun publish(
+        context: Context,
+        intent: Intent,
+        notificationManager: NotificationManager,
+        storage: NotificationStorage,
+        notification: Notification,
+        id: Int,
+    ) {
+        LocalNotificationsPlugin.fireReceived(storage.getSavedNotificationAsJSObject(id.toString()))
+        clearGroup(notificationManager, storage, notification, id)
+        notificationManager.notify(id, notification)
+        rescheduleNotificationIfNeeded(context, intent, id)
+    }
+
+    // MedTracker (MT-125): a repeat replaces the reminder already shown for the same dose
+    // (same group) instead of stacking a second one next to it. Its record goes as on a swipe.
+    private fun clearGroup(notificationManager: NotificationManager, storage: NotificationStorage, notification: Notification, id: Int) {
+        val group = notification.group ?: return
+        notificationManager.activeNotifications
+            .filter { it.id != id && it.notification.group == group }
+            .forEach {
+                notificationManager.cancel(it.tag, it.id)
+                if (LocalNotificationManager.isSafeToForget(storage.getSavedNotification(it.id.toString()))) {
+                    storage.deleteNotification(it.id.toString())
+                }
+            }
+    }
+
+    // MedTracker (MT-152): false only when the server answers in time that the dose no longer
+    // needs a reminder. One deadline covers it all (name lookup, connect, send, read), well inside
+    // the 10 s a receiver may run, so a stalled network can't cost the reminder.
+    private fun stillWanted(check: JSONObject, extra: JSONObject): Boolean {
+        val conn = AtomicReference<HttpURLConnection?>()
+        val ask = Executors.newSingleThreadExecutor()
+        val answer = ask.submit<Boolean> {
+            val c = URL(check.getString("url")).openConnection() as HttpURLConnection
+            conn.set(c)
+            c.connectTimeout = CHECK_DEADLINE_MS
+            c.readTimeout = CHECK_DEADLINE_MS
+            c.requestMethod = "POST"
+            c.doOutput = true
+            c.setRequestProperty("content-type", "application/json")
+            c.setRequestProperty("apikey", check.getString("apikey"))
+            val body = JSONObject()
+                .put("token", check.getString("token"))
+                .put("medId", extra.getString("medId"))
+                .put("scheduledFor", extra.getString("scheduledFor"))
+            c.outputStream.use { it.write(body.toString().toByteArray()) }
+            c.responseCode != 200 || JSONObject(c.inputStream.bufferedReader().use { it.readText() }).optBoolean("ring", true)
+        }
+        return try {
+            answer.get(CHECK_DEADLINE_MS.toLong(), TimeUnit.MILLISECONDS)
+        } catch (e: Exception) {
+            Logger.debug(Logger.tags("LN"), "dose check failed, ringing: $e")
+            true
+        } finally {
+            answer.cancel(true)
+            conn.get()?.disconnect() // also ends a request still waiting on the network
+            ask.shutdownNow()
+        }
+    }
